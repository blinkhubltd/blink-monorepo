# Blink Admin — server-side app, so BOTH public and secret values live here.
# Unlike the mobile apps, a Next server can hold secrets; anything prefixed
# NEXT_PUBLIC_ still ships to the browser, so keep that prefix off secrets.

NEXT_PUBLIC_CONVEX_URL=https://doting-bandicoot-348.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: Google Maps for the coverage and hub-optimization screens.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
