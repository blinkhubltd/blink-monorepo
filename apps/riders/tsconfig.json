{
  "extends": "@repo/typescript/expo.json",
  "compilerOptions": {
    // `@repo/backend` is consumed as raw TypeScript with no build step, so this
    // app compiles the backend's source under ITS OWN compiler options — the
    // backend package's own `noUncheckedIndexedAccess: false` override does not
    // reach consumers. With the flag on, 130 pre-existing errors in
    // packages/backend surface here as if they were this app's.
    //
    // Matching the backend's setting until those 130 are fixed. This is the cost
    // of raw-TS workspace packages and should be removed alongside them.
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "tailwind.config": ["./tailwind.config.js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
