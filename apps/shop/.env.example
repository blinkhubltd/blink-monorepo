# Blink shop (customer app) - client env.
#
# ONLY EXPO_PUBLIC_* belongs here. Anything Metro reads ships inside the APK, so
# server secrets (CLERK_SECRET_KEY, PAYSTACK_SECRET_KEY,
# SERVER_GOOGLE_MAPS_API_KEY, bank details) live in Convex env vars - never in
# this file. The app this replaces kept its Clerk and Paystack SECRET keys in
# the same .env.local the Expo app loaded, which is one EXPO_PUBLIC_ typo away
# from shipping them to every customer.

EXPO_PUBLIC_CONVEX_URL=https://doting-bandicoot-348.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Restrict this key to com.blink.app and the iOS bundle id before shipping.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Publishable key only. The charge is verified server-side in Convex with the
# secret key, so a leaked publishable key cannot move money.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

CONVEX_DEPLOYMENT=dev:doting-bandicoot-348

# Every EXPO_PUBLIC_ var above is OPTIONAL locally, so a fresh clone runs without
# configuration, and REQUIRED under EAS - app.config.ts throws at config time
# when EAS_BUILD=true and any is missing. The production eas.json profile
# deliberately inlines none of them, so they must exist in the EAS "production"
# environment or the build fails rather than silently pointing at the dev
# deployment.
