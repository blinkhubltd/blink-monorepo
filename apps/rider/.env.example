# Blink Rider — client env.
# ONLY EXPO_PUBLIC_* belongs here. Anything Metro reads ships inside the APK.
# Server secrets (CLERK_SECRET_KEY, PAYSTACK_SECRET_KEY, SERVER_GOOGLE_MAPS_API_KEY,
# bank details) live in Convex env vars — never in this file.

EXPO_PUBLIC_CONVEX_URL=https://doting-bandicoot-348.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

CONVEX_DEPLOYMENT=dev:doting-bandicoot-348
