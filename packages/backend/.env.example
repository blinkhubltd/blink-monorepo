# ─── packages/backend/.env.local ──────────────────────────────────────────────
# Names only. Never commit real values.
#
# Convex deployment binding (set by `npx convex dev`)
CONVEX_DEPLOYMENT=

# ─── Convex deployment environment variables ─────────────────────────────────
# These are NOT read from this file at runtime. Convex reads them from the
# deployment's own environment, set per-deployment with:
#     npx convex env set NAME value            (dev)
#     npx convex env set NAME value --prod     (production)
# They are listed here as documentation of what each deployment must have.
#
# Clerk — auth.config.ts throws at module load if the issuer is missing,
# which correctly blocks the deploy.
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
# clerk.ts reads this at module load but only throws inside the handler, so a
# missing value lets the deployment boot healthy while every user-sync webhook
# 500s silently. Phase B1 promotes that check to module load.
CLERK_WEBHOOK_SECRET=

# Paystack — server-side only. Never expose to a client bundle.
PAYSTACK_SECRET_KEY=

# Google Maps — server-side key, used by geocode.ts and directions.ts.
# Distinct from the EXPO_PUBLIC_/NEXT_PUBLIC_ client keys.
SERVER_GOOGLE_MAPS_API_KEY=

# Referenced in code but absent from every source .env — confirm in B0 whether
# these are set on the live deployment.
LOCATION_INGEST_API_KEY=

# Platform payout accounts (Paystack split destinations)
PRIMARY_BUSINESS_NAME=
PRIMARY_BANK_CODE=
PRIMARY_ACCOUNT_NUMBER=
SECONDARY_BUSINESS_NAME=
SECONDARY_BANK_CODE=
SECONDARY_ACCOUNT_NUMBER=
TEST_BANK_CODE=
TEST_ACCOUNT_NUMBER=

BASE_URL=

# CONVEX_DEPLOY_KEY
#
# Set locally only if you cannot `convex login` with access to the blinkhubltd
# team. A deploy key does NOT carry `deployment:logs:view`, so plain `convex dev`
# pushes fine and then dies with "socket hang up" when it tries to tail logs.
# That is why `pnpm dev` here passes `--tail-logs disable`; use `pnpm dev:logs`
# once your user account has team access.
